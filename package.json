{
  "name": "tree-sitter-tcsh",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for documented tcsh/csh surface syntax.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j3bit/tree-sitter-tcsh.git"
  },
  "homepage": "https://github.com/j3bit/tree-sitter-tcsh#readme",
  "bugs": {
    "url": "https://github.com/j3bit/tree-sitter-tcsh/issues"
  },
  "type": "commonjs",
  "keywords": [
    "tree-sitter",
    "tcsh",
    "csh"
  ],
  "license": "MIT",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:update": "tree-sitter test --update",
    "parse": "tree-sitter parse --grammar-path . --",
    "check:coverage-matrix": "node scripts/check-coverage-matrix.js",
    "check:node-contract": "node scripts/check-node-contract.js",
    "check:no-error": "node scripts/check-no-error.js",
    "check:upstream": "node scripts/check-upstream-samples.js",
    "check:release-metadata": "node scripts/check-release-metadata.js",
    "check:static": "npm run check:node-contract && npm run check:scanner && npm run check:c-compile",
    "check:parser": "node scripts/check-parser-runtime.js",
    "check:parser:release": "node scripts/check-parser-runtime.js --release",
    "check": "npm run generate && npm run check:static && npm run check:parser",
    "check:release": "npm run check:release-metadata && npm run check:static && npm run check:parser:release && npm run check:package",
    "check:queries": "node scripts/check-queries.js",
    "check:query-captures": "node scripts/check-query-captures.js",
    "check:coverage-matrix:release": "node scripts/check-coverage-matrix.js --release",
    "check:scanner": "cc -std=c11 -Wall -Wextra -Werror -Isrc test/scanner_test.c src/scanner.c -o /tmp/tree-sitter-tcsh-scanner-test && /tmp/tree-sitter-tcsh-scanner-test",
    "check:c-compile": "cc -std=c11 -Wall -Wextra -Werror -Isrc -c src/parser.c -o /tmp/tree-sitter-tcsh-parser.o && cc -std=c11 -Wall -Wextra -Werror -Isrc -c src/scanner.c -o /tmp/tree-sitter-tcsh-scanner.o",
    "check:recovery": "node scripts/check-recovery.js",
    "check:stress": "node scripts/check-stress.js",
    "check:package": "node scripts/check-package.js"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.8"
  },
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "Makefile",
    "CMakeLists.txt",
    "bindings/c/",
    "queries/",
    "src/",
    "docs/builtin-index.md",
    "docs/feature-plan.md",
    "docs/reference-ledger.md",
    "docs/scanner-design.md",
    "docs/syntax-coverage-matrix.md",
    "LICENSE",
    "README.md"
  ]
}
